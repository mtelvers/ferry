# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Ad-hoc streaming pipelines across ssh hosts, with a TUI"
description:
  "ferry runs a pipeline of shell stages over a stream of item IDs. Each stage runs on a host reachable by ssh, with its own concurrency limit; items move to the next stage the moment they finish. A notty TUI shows every stage's queue and the logs of each job."
maintainer: ["Mark Elvers <mark.elvers@tunbury.org>"]
authors: ["Mark Elvers <mark.elvers@tunbury.org>"]
license: "MIT"
depends: [
  "dune" {>= "3.19"}
  "ocaml" {>= "5.0"}
  "notty"
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
